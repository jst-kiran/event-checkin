# ==========================================================================
# Event Check-In — server-side environment variables
# ==========================================================================
# Every variable below is read ONLY by the serverless functions in /api and by
# scripts/generate-registration-snapshot.js.
#
# None of them are prefixed with VITE_, which is what keeps them out of the
# browser bundle. NEVER add a VITE_ prefix to any of these — Vite inlines every
# VITE_* value into the JavaScript it ships to the client.
#
# Local development : copy this file to `.env` and fill it in.
# Production        : Vercel -> Settings -> Environment Variables (same keys).
# ==========================================================================


# --------------------------------------------------------------------------
# Google service account
# --------------------------------------------------------------------------
# The client_email from the service account JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=event-checkin@your-project.iam.gserviceaccount.com

# The private_key from the same JSON key file, including the BEGIN/END lines.
#
# The key is multi-line. Two formats are accepted:
#   1. Quoted, with literal backslash-n escapes (best for .env files):
#        GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
#   2. A genuinely multi-line value (best for the Vercel dashboard, where you
#      can paste the key exactly as it appears in the JSON file).
#
# Both are normalized at runtime, so paste whichever you have.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS-PART-IS-THE-ID>/edit
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SHEET_ID=


# --------------------------------------------------------------------------
# Organizer login for /admin/login
# --------------------------------------------------------------------------
ADMIN_EMAIL=organizer@example.com

# Use a long, unique password. It is compared in constant time on the server
# and never leaves the server.
ADMIN_PASSWORD=

# Signs the admin session cookie (HMAC-SHA256). REQUIRED — admin login is
# disabled if this is missing, rather than falling back to a weaker key.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --------------------------------------------------------------------------
# Public front-end configuration
# --------------------------------------------------------------------------
# VITE_ values ARE bundled into the browser JavaScript. That is correct for a
# public link and must never be used for anything secret.
#
# Shown as "Explore E-Books" after a successful check-in. Until a real https
# URL is set, the button renders disabled with "E-books link coming soon"
# rather than linking somewhere broken.
VITE_EBOOKS_URL=https://drive.google.com/drive/folders/1ssItJ3qr1lc9sLgqwRD7M_TCLHZdpWVb?usp=drive_link


# --------------------------------------------------------------------------
# Optional
# --------------------------------------------------------------------------
# Tab holding future project submissions. Created automatically if absent.
# SHEET_PROJECTS=ProjectUploads

# Tab names, only if your spreadsheet uses something other than the defaults.
# SHEET_CHECKIN=CheckIn
# SHEET_LUNCH=Lunch
# SHEET_REGISTRATIONS=Registrations

# Tab holding admin-configurable settings (currently just the project
# submission deadline). Created automatically if absent.
# SHEET_SETTINGS=Settings

# Points the registration service at a different snapshot file.
# Intended for local testing only; leave unset in production so the committed
# data/registrations.json is always the one that is served.
# REGISTRATIONS_PATH=
