# ==========================================================================
# Registration check-in — server-side environment variables
# ==========================================================================
# Every variable below is read ONLY by the serverless functions in /api and by
# scripts/check-registration-sheet.js.
#
# None of them are prefixed with VITE_, which is what keeps them out of the
# browser bundle. NEVER add a VITE_ prefix to any of these — Vite inlines every
# VITE_* value into the JavaScript it ships to the client.
#
# Local development : copy this file to `.env` and fill it in.
# Production        : Vercel -> Settings -> Environment Variables (same keys).
# ==========================================================================


# --------------------------------------------------------------------------
# Google service account
# --------------------------------------------------------------------------
# The client_email from the service account JSON key file.
# Share the registration spreadsheet with this address as an EDITOR: the app
# needs it to create and fill the CheckIns tab. It never writes to the
# registration tab (the code refuses), and you can also protect that tab in
# Google Sheets (Data -> Protect sheets and ranges -> "Only you").
GOOGLE_SERVICE_ACCOUNT_EMAIL=event-checkin@your-project.iam.gserviceaccount.com

# The private_key from the same JSON key file, including the BEGIN/END lines.
#
# The key is multi-line. Two formats are accepted:
#   1. Quoted, with literal backslash-n escapes (best for .env files):
#        GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
#   2. A genuinely multi-line value (best for the Vercel dashboard, where you
#      can paste the key exactly as it appears in the JSON file).
#
# Both are normalized at runtime, so paste whichever you have.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"


# --------------------------------------------------------------------------
# Registration source — REQUIRED, no defaults
# --------------------------------------------------------------------------
# The event's registration spreadsheet. Either the bare ID or the full URL:
#   https://docs.google.com/spreadsheets/d/<THIS-PART-IS-THE-ID>/edit
# For a new event, change this (and the tab name below) — nothing else.
REGISTRATION_SHEET_ID=

# The exact name of the tab holding the form responses, as shown at the bottom
# of the spreadsheet (a Google Form names it "Form responses 1").
REGISTRATION_SHEET_NAME=Form responses 1

# Optional. How long (seconds, 0-600) a server instance may reuse what it last
# read from the sheet. New registrations become visible within this window.
# REGISTRATION_CACHE_SECONDS=60

# Optional. The tab check-ins are written to — the ONLY tab the app writes.
# Created automatically (with manual/walk-in highlighting) on first check-in.
# Must differ from REGISTRATION_SHEET_NAME.
# CHECKIN_SHEET_NAME=CheckIns

# Optional. Time zone for check-in timestamps (default Asia/Kolkata).
# EVENT_TIMEZONE=Asia/Kolkata


# --------------------------------------------------------------------------
# Organizer login for /admin — REQUIRED for the dashboard
# --------------------------------------------------------------------------
ADMIN_EMAIL=organizer@example.com

# Use a long, unique password. It is compared in constant time on the server
# and never leaves the server.
ADMIN_PASSWORD=

# Signs the admin session cookie (HMAC-SHA256). Admin login is disabled if this
# is missing or shorter than 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --------------------------------------------------------------------------
# Public front-end configuration (optional)
# --------------------------------------------------------------------------
# VITE_ values ARE bundled into the browser JavaScript. That is correct for
# public display text and must never be used for anything secret.
#
# Shown in a pill under the verification card when set.
# VITE_EVENT_DATE=12 October 2026
# VITE_EVENT_LOCATION=Main Auditorium
